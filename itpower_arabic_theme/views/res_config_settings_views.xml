<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.itpower.arabic.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="after">
                <block title="Backend Theme" name="itp_theme_settings">
                    <setting string="Theme Colors" company_dependent="1"
                             help="Colors of the top bar, the apps sidebar, the buttons and the highlights. Reload the page after saving.">
                        <div class="o_itp_colors_grid mt-2">
                            <label for="itp_color_brand" string="Top Bar"/>
                            <field name="itp_color_brand" widget="color"/>
                            <label for="itp_color_sidebar" string="Sidebar"/>
                            <field name="itp_color_sidebar" widget="color"/>
                            <label for="itp_color_primary" string="Buttons"/>
                            <field name="itp_color_primary" widget="color"/>
                            <label for="itp_color_accent" string="Highlights"/>
                            <field name="itp_color_accent" widget="color"/>
                        </div>
                        <button name="action_itp_reset_theme" type="object" icon="oi-arrow-right"
                                string="Reset to the default theme" class="btn-link"/>
                    </setting>
                    <setting string="Apps Menu Background" company_dependent="1"
                             help="Image shown behind the full-screen apps menu.">
                        <field name="itp_apps_background" widget="image" class="w-50 mt-2"/>
                    </setting>
                    <setting string="Browser Tab Icon" company_dependent="1"
                             help="Small icon shown in the browser tab (favicon).">
                        <field name="itp_favicon" widget="image" class="mt-2" options="{'size': [48, 48]}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
